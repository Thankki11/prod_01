# Sao chép thành .env (dev) hoặc .env.prod (production) rồi thay giá trị thật.
# KHÔNG commit file .env chứa giá trị thật.

# --- MySQL ---
MYSQL_DATABASE=diemdanh
MYSQL_USER=diemdanh
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# --- Backend ---
# Khoá ký JWT và mã QR. Tạo bằng: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
QR_ROTATE_SECONDS=15
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Địa chỉ web mà sinh viên mở khi quét QR
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Seed (chỉ dùng cho dev / lần chạy đầu) ---
SEED_ADMIN_PASSWORD=change-me-admin
SEED_DEMO_PASSWORD=change-me-demo

# --- Production ---
# Tên miền trỏ về VM, Caddy sẽ tự cấp HTTPS
DOMAIN=diemdanh.example.com
